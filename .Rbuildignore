^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$
^README\.Rmd$
^\.github$
^dev$
^docs$
^_pkgdown\.yml$
^pkgdown$
^man/figures$
^cran-comments\.md$
^\.Rhistory$
^\.gitignore$
# Stray graphics-device output. Base plot() called with no open device writes
# Rplots.pdf into the working directory, and R CMD build will happily ship it.
# NOT anchored to the package root: the copy that actually gets made is the one
# in inst/scripts/, written whenever a tour script is sourced from that folder,
# and inst/ is exactly the tree that ships.
(^|/)Rplots\.pdf$
\.DS_Store$
^Claude outputs$
